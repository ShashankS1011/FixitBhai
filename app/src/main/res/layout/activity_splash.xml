<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/logoContainer"
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:contentDescription="FixitBhai Logo"
                android:src="@drawable/ic_fixitbhai_logo" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="FixitBhai"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Local service contacts, sorted."
            android:textColor="#B0BEC5"
            android:textSize="15sp" />

        <!-- Funny Fortnite Disclaimer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="*No, it's not the Fortnite logo. We promise."
            android:textColor="#78909C"
            android:textSize="11sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- Footer Disclaimer -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Made with Mother's Fear &amp; Pure Panic"
            android:textColor="#64B5F6"
            android:textSize="12sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="(because if the pipe leaks again, I am getting evicted)"
            android:textColor="#78909C"
            android:textSize="10sp" />
    </LinearLayout>

</RelativeLayout>