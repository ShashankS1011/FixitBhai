<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.FixitBhai" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Palette -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorPrimaryContainer">@color/surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>

        <!-- Secondary Palette -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorOnSecondary">@color/text_primary</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- System Bar Styling -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>

        <!-- Material Card Default -->
        <item name="materialCardViewStyle">@style/SleekCardStyle</item>
    </style>

    <!-- Professional Sleek Card Style -->
    <style name="SleekCardStyle" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardCornerRadius">16dp</item>

        <item name="strokeColor">#1E293B</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Professional Sleek Primary Button -->
    <style name="SleekPrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_blue</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <!-- Professional Sleek Outlined Button -->
    <style name="SleekOutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/accent_blue</item>
        <item name="strokeColor">@color/accent_blue</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingVertical">12dp</item>
    </style>
</resources>